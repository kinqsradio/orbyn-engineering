{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbyn Engineering",
  "identifier": "com.kinqsradio.orbyn.engineering",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../loader"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Orbyn Engineering",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": ["binaries/orbynd"],
    "resources": { "../../build/ui": "ui", "../../build/skills": "skills" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "hardenedRuntime": true },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
