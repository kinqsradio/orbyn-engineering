<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the macOS bundle only. It lists the app as able to open web links,
       so a person can choose it as their default browser; it sets nothing by itself.
       `orbyn` is repeated here because this list replaces the one the deep link
       plugin writes. Windows declares no web links: see H13 in docs/parity.md. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.kinqsradio.orbyn.engineering</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>orbyn</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web site URL</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
