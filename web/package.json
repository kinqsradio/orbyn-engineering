{
  "name": "orbyn-engineering-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/assert-no-mock.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "node scripts/install-browser.mjs",
    "generate": "cd .. && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test -p orbyn-contracts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
